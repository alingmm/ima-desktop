[project]
requires = ["nodejs-24"]

[dev]
build = ["sh", "-c", "ELECTRON_SKIP_BINARY_DOWNLOAD=1 pnpm run install:all"]
run = ["pnpm", "run", "dev"]

[deploy]
build = ["sh", "-c", "ELECTRON_SKIP_BINARY_DOWNLOAD=1 pnpm install --frozen-lockfile=false && pnpm run build:all"]
run = ["pnpm", "run", "start"]
